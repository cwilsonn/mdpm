{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "pattern": "^(lucide|simple-icons):[a-z0-9-]+$"
    },
    "hosts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schemes": {
      "default": [
        "https",
        "http"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9+.-]*$"
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "default": {
            "type": "string"
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      }
    },
    "kinds": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "issue",
              "change",
              "doc",
              "message",
              "repo",
              "url"
            ]
          },
          {
            "not": {}
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "noun": {
            "type": "string",
            "minLength": 1
          },
          "plural": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "pattern": "^(lucide|simple-icons):[a-z0-9-]+$"
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "noun",
          "display",
          "url",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "repo": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "remote"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "icon",
    "kinds"
  ],
  "additionalProperties": false
}
