{
  "$schema": "../schemas/provider.schema.json",
  "schemaVersion": 1,
  "id": "github",
  "name": "GitHub",
  "icon": "simple-icons:github",
  "hosts": [
    "github.com"
  ],
  "kinds": {
    "change": {
      "noun": "Pull request",
      "plural": "Pull requests",
      "icon": "lucide:git-pull-request",
      "display": "#{number}",
      "url": "https://{host}/{repo}/pull/{number}",
      "match": "^https?://(?<host>[^/]+)/(?<repo>[^/]+/[^/]+)/pull/(?<number>\\d+)(?:[/?#].*)?$",
      "ref": "{repo}#{number}",
      "short": "^#(?<number>\\d+)$"
    },
    "issue": {
      "noun": "Issue",
      "plural": "Issues",
      "icon": "lucide:circle-dot",
      "display": "#{number}",
      "url": "https://{host}/{repo}/issues/{number}",
      "match": "^https?://(?<host>[^/]+)/(?<repo>[^/]+/[^/]+)/issues/(?<number>\\d+)(?:[/?#].*)?$",
      "ref": "{repo}#{number}",
      "short": "^#(?<number>\\d+)$"
    },
    "repo": {
      "noun": "Repository",
      "icon": "lucide:folder-git-2",
      "display": "{repo}",
      "url": "https://{host}/{repo}",
      "match": "^https?://(?<host>[^/]+)/(?<repo>[^/]+/[^/#?]+?)(?:\\.git)?/?$",
      "ref": "{repo}"
    }
  },
  "repo": {
    "remote": "^(?:git@|ssh://git@|https?://)(?<host>[^/:]+)[:/](?<repo>[^/]+/[^/]+?)(?:\\.git)?/?$"
  }
}
