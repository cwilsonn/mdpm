    "better-sqlite3": "^12.10.0",
    "citty": "^0.2.2",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "nuxt": "^4.4.2",
    "tailwindcss": "^4.3.0",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.102",
