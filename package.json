{
  "name": "mdpm",
  "private": true,
  "version": "0.17.1",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "bin": {
    "mdpm": "./bin/mdpm.mjs"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp nuxt dev",
    "build": "pnpm rebuild better-sqlite3 && nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck:cli": "tsc -p tsconfig.cli.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "ngrok": "ngrok http 3333"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@nuxt/content": "^3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.1.1",
    "citty": "^0.2.2",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue-draggable-plus": "^0.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
