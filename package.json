{
  "name": "mdpm",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "bin": {
    "mdpm": "./bin/mdpm.mjs"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck:cli": "tsc -p tsconfig.cli.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "ngrok": "ngrok http 3333",
    "test:a11y": "nuxt build && playwright test -c tests/a11y/playwright.config.ts",
    "test:a11y:run": "playwright test -c tests/a11y/playwright.config.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.154",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/mdc": "^0.23.3",
    "@vueuse/core": "^15.0.0",
    "citty": "^0.2.2",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue-draggable-plus": "^0.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
