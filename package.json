{
  "name": "mdpm",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "bin": {
    "mdpm": "./bin/mdpm.mjs"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp nuxt dev",
    "build": "pnpm rebuild better-sqlite3 && nuxt build",
